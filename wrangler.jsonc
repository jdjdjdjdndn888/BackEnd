{
  // Cloudflare Workers + Assets deployment config.
  // "assets.directory" points to Vite's build output.
  // "not_found_handling" serves index.html for any unmatched path so
  // React Router handles client-side routing (replaces the broken
  // "/* /index.html 200" _redirects rule that triggered code 100324).
  "name": "fontend",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
