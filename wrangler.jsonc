{
  // Cloudflare Workers + Assets deployment config.
  "name": "gemtide",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "main": "./workers/native-api/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gemtide-native"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
  ]
}
