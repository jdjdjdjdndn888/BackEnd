{
  // Legacy alias retained for local commands that explicitly select it.
  // Cloudflare's default deployment config is wrangler.jsonc.
  "name": "gemtide",
  "compatibility_date": "2024-09-23",
  "main": "./workers/native-api/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gemtide-native"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
  ]
}