{
  // Cloudflare edge adapter for the MongoDB-backed Node API.
  // Set API_ORIGIN to the existing Node/Render API before deploying.
  "name": "gemtide-api-edge",
  "main": "./workers/api-proxy.js",
  "compatibility_date": "2024-09-23",
  "vars": {
    "API_ORIGIN": "https://replace-with-your-node-api-origin.example.com"
  }
}